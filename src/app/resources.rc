#include <windows.h>

// Embedded application manifest (DPI awareness, Win10 compatibility).
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Explorer icon (generated by tools/make_icon.py).
1 ICON "snowflake.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 1, 1, 0
PRODUCTVERSION 0, 1, 1, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WinTers - snow on your desktop"
            VALUE "FileVersion", "0.1.1.0"
            VALUE "InternalName", "WinTers"
            VALUE "OriginalFilename", "WinTers.exe"
            VALUE "ProductName", "WinTers"
            VALUE "ProductVersion", "0.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
