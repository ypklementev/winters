#include <windows.h>

#include "version.h"  // generated by CMake

// Embedded application manifest (DPI awareness, Win10 compatibility).
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Explorer icon (generated by tools/make_icon.py).
1 ICON "snowflake.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WINTERS_VERSION_MAJOR, WINTERS_VERSION_MINOR, WINTERS_VERSION_PATCH, 0
PRODUCTVERSION WINTERS_VERSION_MAJOR, WINTERS_VERSION_MINOR, WINTERS_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WinTers - snow on your desktop"
            VALUE "FileVersion", WINTERS_VERSION_STR
            VALUE "InternalName", "WinTers"
            VALUE "OriginalFilename", "WinTers.exe"
            VALUE "ProductName", "WinTers"
            VALUE "ProductVersion", WINTERS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
